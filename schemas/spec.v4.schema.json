{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge3d.local/schemas/spec.v4.schema.json",
  "title": "forge3d/spec@4",
  "description": "spec@4 = spec@3 + campos opcionais de qualidade de entrega (retopologia, quadriflow_faces, modo_rig_roblox, estilo por item). Aditivo: todo documento spec@3 continua valido.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "projeto",
    "perfil",
    "destino_exportacao",
    "lote"
  ],
  "properties": {
    "schema": {
      "const": "forge3d/spec@4"
    },
    "projeto": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$",
      "maxLength": 64,
      "description": "slug do projeto de jogo consumidor"
    },
    "perfil": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "godot4 | roblox-r15 | caminho para YAML de perfil"
    },
    "destino_exportacao": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "description": "destino sob allowlist; /mnt/* e UNC sao recusados (I12, I13)"
    },
    "estilo_global": {
      "description": "default de estilo. Aliases legados (docs/contratos.md) sao normalizados pelo carregador ANTES da validacao (FORGE-W-ALIAS, D19): o schema so aceita o valor canonico.",
      "enum": [
        "blocky_voxel",
        "lowpoly_lit",
        "stylized_pbr"
      ]
    },
    "paleta": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$"
      }
    },
    "politica": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "falha": {
          "enum": [
            "continuar",
            "abortar"
          ]
        },
        "custo_max_min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        },
        "seed_base": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "requisicao": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "isolamento": {
          "enum": [
            "padrao",
            "estrito"
          ]
        },
        "limpar_destino": {
          "type": "boolean"
        },
        "base_externa": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "origem",
            "sha256"
          ],
          "properties": {
            "tipo": {
              "enum": [
                "prop_estatico",
                "prop_equipavel",
                "personagem_humanoide",
                "criatura",
                "modulo_cenario",
                "textura",
                "mapa_setor"
              ]
            },
            "origem": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "sha256": {
              "type": "string",
              "pattern": "^(sha256:)?[0-9a-fA-F]{64}$"
            },
            "prompt": {
              "type": "string",
              "maxLength": 2048
            },
            "seed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          }
        }
      }
    },
    "lote": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tipo"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+){1,4}$",
          "maxLength": 80,
          "description": "identidade estavel; mudar o id significa asset novo"
        },
        "tipo": {
          "enum": [
            "prop_estatico",
            "prop_equipavel",
            "personagem_humanoide",
            "criatura",
            "modulo_cenario",
            "textura",
            "mapa_setor"
          ]
        },
        "rota": {
          "enum": [
            "blocky",
            "import",
            "mesh",
            "modular"
          ]
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "altura_metros": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10.0
        },
        "pivot": {
          "enum": [
            "empunhadura",
            "base",
            "centro",
            "origem",
            "topo"
          ]
        },
        "limite_triangulos": {
          "type": "integer",
          "minimum": 50,
          "maximum": 50000
        },
        "material": {
          "enum": [
            "opaque",
            "alpha_clip",
            "transparent",
            "pbr"
          ]
        },
        "colisao": {
          "enum": [
            "none",
            "box",
            "convex",
            "ucx"
          ]
        },
        "lod": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "integer",
            "minimum": 5,
            "maximum": 100
          },
          "description": "percentuais decrescentes; primeiro elemento deve ser 100 (B4)"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "auto_rig": {
          "type": "boolean"
        },
        "esqueleto": {
          "type": "string",
          "pattern": "^(godot-humanoid|r15)@[0-9]+$"
        },
        "animacoes_base": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "description": "reservado (D14): preenchido gera FORGE-W-ANIM, nunca erro"
        },
        "origem": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "tags": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          }
        },
        "paleta": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "description": "sobrepoe a paleta do lote para este item, na ordem de papeis do tipo"
        },
        "parte": {
          "enum": [
            "corpo",
            "capa",
            "arma",
            "cabelo",
            "elmo",
            "ombreiras",
            "peitoral",
            "luvas",
            "calcas",
            "calças",
            "botas",
            "escudo"
          ],
          "description": "peca de kit (B11: rota blocky ou mesh; B12: tipo por peca; B13: peca estatica ou skinned)"
        },
        "skinned": {
          "type": "boolean",
          "description": "se verdadeiro, armadura/roupa recebe deformacao por esqueleto compartilhado em vez de socket estatico"
        },
        "template_humanoide": {
          "type": "boolean",
          "description": "usa malha base MPFB2 (CC0) com projecao frontal da foto para personagem_humanoide"
        },
        "makehuman_cabelo": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_/-]{0,63}$",
          "description": "estilo de cabelo CC0 do MakeHuman/MPFB2 (ex: long01, bob01, ponytail01, short01)"
        },
        "cor_cabelo": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "tintura opcional (#RRGGBB) aplicada a textura do cabelo MakeHuman"
        },
        "macro": {
          "type": "object",
          "description": "parametros macro MPFB2 opcionais compartilhados entre corpo e cabelo modular"
        },
        "modular": {
          "type": "object",
          "description": "Rota modular: grade de setores e catalogo de modulos (D74/D75)",
          "additionalProperties": false,
          "required": [
            "grade",
            "modulos"
          ],
          "properties": {
            "grade": {
              "type": "array",
              "description": "colunas x linhas da dungeon, em setores",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 32
              }
            },
            "modulos": {
              "type": "array",
              "description": "modulos do catalogo que podem ser sorteados pelo WFC",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              }
            },
            "setor": {
              "type": "array",
              "description": "setor exportado por este item (x, y); default 0,0",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            "tamanho_modulo": {
              "type": "number",
              "description": "lado do modulo em metros (default 4,0)",
              "exclusiveMinimum": 0,
              "maximum": 64
            }
          }
        },
        "qualidade": {
          "enum": [
            "standard",
            "hero"
          ],
          "description": "nivel de orcamento geometrico (hero eleva o teto padrao de triangulos em personagens/criaturas)"
        },
        "pose_guard": {
          "enum": [
            "off",
            "auto",
            "repose"
          ],
          "description": "guarda de pose de entrada para autorig"
        },
        "extrudir_2d": {
          "type": "boolean",
          "description": "ativa extrusao 2D para silhuetas planas"
        },
        "estilo": {
          "enum": [
            "blocky_voxel",
            "lowpoly_lit",
            "stylized_pbr"
          ],
          "description": "sobrescreve estilo_global para este item (blocky_voxel, lowpoly_lit, stylized_pbr)"
        },
        "retopologia": {
          "enum": [
            "padrao",
            "quadriflow",
            "decimate"
          ],
          "description": "estrategia opcional de retopologia em malhas de IA/mesh"
        },
        "quadriflow_faces": {
          "type": "integer",
          "minimum": 250,
          "maximum": 50000,
          "description": "alvo opcional de faces para remesh quadriflow"
        },
        "modo_rig_roblox": {
          "enum": [
            "motor6d",
            "bone"
          ],
          "description": "modo de rig R15 no Roblox Studio (motor6d padrao por pecas ou Bone skinning unico)"
        }
      },
      "allOf": [
        {
          "description": "B2: rota mesh exige seed e prompt",
          "if": {
            "required": [
              "rota"
            ],
            "properties": {
              "rota": {
                "const": "mesh"
              }
            }
          },
          "then": {
            "required": [
              "seed",
              "prompt"
            ]
          }
        },
        {
          "description": "B3: rota import exige origem",
          "if": {
            "required": [
              "rota"
            ],
            "properties": {
              "rota": {
                "const": "import"
              }
            }
          },
          "then": {
            "required": [
              "origem"
            ]
          }
        },
        {
          "description": "B4: altura_metros obrigatoria exceto textura e mapa_setor",
          "if": {
            "required": [
              "tipo"
            ],
            "properties": {
              "tipo": {
                "enum": [
                  "textura",
                  "mapa_setor"
                ]
              }
            }
          },
          "else": {
            "required": [
              "altura_metros"
            ]
          }
        },
        {
          "description": "B6: auto_rig so em humanoide ou criatura",
          "if": {
            "required": [
              "auto_rig"
            ],
            "properties": {
              "auto_rig": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "tipo": {
                "enum": [
                  "personagem_humanoide",
                  "criatura"
                ]
              }
            }
          }
        },
        {
          "description": "B11: 'parte' so nas rotas blocky ou mesh",
          "if": {
            "required": [
              "parte"
            ]
          },
          "then": {
            "properties": {
              "rota": {
                "enum": [
                  "blocky",
                  "mesh"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
